{
  "name": "@onedef/mcp-elicitation-workflow",
  "version": "0.2.0",
  "description": "Elicitation workflows: TanStack Workflow runs that ask a human (MCP elicitation, same API) or the driving agent, and continue where they stopped — no code before the question runs twice. MCP tools in one call; runs in any key-value store or Redis.",
  "license": "MIT",
  "homepage": "https://onedef.cahidarda.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CahidArda/onedef.git",
    "directory": "packages/mcp-elicitation-workflow"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "default": "./dist/redis.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@tanstack/workflow-core": "0.0.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2",
    "@modelcontextprotocol/server": "^2",
    "@types/node": "^24",
    "zod": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
