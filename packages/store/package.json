{
  "name": "@onedef/store",
  "version": "0.2.0",
  "description": "Implement an onedef contract on a key-value store: list/get/delete are generated, create and actions just return the object, process runs are kept there too. Files, Redis or memory.",
  "license": "MIT",
  "homepage": "https://onedef.cahidarda.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CahidArda/onedef.git",
    "directory": "packages/store"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js",
      "default": "./dist/fs.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "default": "./dist/redis.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "onedef": "workspace:*",
    "@onedef/process": "workspace:*"
  },
  "peerDependencies": {
    "@upstash/redis": "^1"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24",
    "@upstash/redis": "^1",
    "zod": "^4.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
