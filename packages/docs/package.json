{
  "name": "@onedef/docs",
  "version": "0.2.0",
  "description": "Spec-driven Mintlify docs for a onedef contract.",
  "license": "MIT",
  "homepage": "https://onedef.cahidarda.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CahidArda/onedef.git",
